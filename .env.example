# .env 만들기: 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채운다.
# .env 는 .gitignore 에 있어 git 에 올라가지 않는다. 키를 채팅이나 커밋에 붙이지 않는다.
# 이 키들은 개발 도구(tools/)에서만 쓴다. 게임(src/)이나 배포 빌드에는 절대 넣지 않는다.

# 시댄스 영상 생성 — BytePlus ModelArk (공식 API) 의 API 키
ARK_API_KEY=
# ModelArk 주소 (지역에 따라 다르다. 콘솔에 적힌 주소를 쓴다)
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ElevenLabs — 효과음(text to sound effects)과 짧은 목소리
ELEVENLABS_API_KEY=

# 또는 Cloudflare Worker 중계를 쓸 때 (진짜 키는 Worker의 Secret에만, tools/proxy/worker.js)
PROXY_URL=
PROXY_TOKEN=
